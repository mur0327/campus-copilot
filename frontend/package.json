{
  "name": "campus-copilot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:mock": "VITE_USE_MOCK_API=true VITE_ENABLE_KIOSK_FALLBACK=true vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "smoke": "npm run typecheck && npm run test:run && npm run build && npm run smoke:preview",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.99.0",
    "hangul-js": "^0.2.6",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.14.0",
    "react-simple-keyboard": "^3.8.201",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.5"
  }
}
